/div></div></div><div class="F0wyae oGsu4"><div class="yMXUbf"><div class="NGoCob SAS2Ne" jsname="A9KrYd"><div jsname="sp9p4" class="cPjwNc" id="fuyiek1nlNk/zAr9yb"></div><span class="nzVtF" id="fuyiek1nlNk/SduuEf"><span jslog="77170; track:click" aria-level="3" role="heading" jscontroller="AkvWld" jsmodel="hBNfic" jsdata="Zoi81;user/117129257060532187798;$132 jUcABe;dm/5PvVNKAAAAE;$133 rtchQb;human/117129257060532187798;$134" jsaction="SgHM0b:P9heyc;" jsname="oU6v8b" data-member-id="user/human/117129257060532187798" data-compare-to-self-user="true" data-show-self-user-as-you="true" data-is-message="true" data-show-bot-text="true" data-show-email-for-placeholder-user="true" data-origin-gsuite-app="0" data-message-id="fuyiek1nlNk" data-show-app-hover-card="true" data-hovercard-id="sanchez130620@gmail.com" data-hovercard-element-id="1427023692" data-name="Maicol Fernandez" data-ui-usage-type="1" class="ZTmjQb Z4BnXb"><span translate="no" class="njhDLd O5OMdc">Maicol Fernandez</span><span jscontroller="T3x1Me" jsaction="L0qzIc:tCdxT;" style="display:none" data-ui-usage-type="1"></span></span></span><div class="dAxhmf vfxfld" data-cd="inline" aria-hidden="true"><span class="cPjwNc">, </span><div class="b8Cb3d MZlSed" data-cd="inline"><span jsname="E53oB" jscontroller="cIODtd" jsaction="rcuQ6b:UyF3Zb;" data-format="2" data-lowercase="false" data-ceil="false" data-server-side-rendered="false" data-absolute-timestamp="1788275892581" class="FvYVyf " role="presentation">1 sept, 10:18</span></div><span class="cPjwNc" role="presentation" data-cd="hidden">, </span><span class="XmqxJb"><div jsname="G4syIf" class="JBPNdf" jslog="234524; track:ved" jsaction="JIbuQc: trigger.Zs6CBf"></div><span jsname="ZcbG1" class="AV0G4e"></span></span></div></div></div><div class="iKCcE"><div class="B8q9Gf qnQFwb VYsRpc hu21Y" jsname="o7uNDd" jsaction="clickonly:SZBoRc;mouseenter:K23Ded;mouseleave:CMQEbf;" jslog="75825; track:impression,click;metadata:;"><div class="zlPNZe"><div class="Hj5Fxb"><div class="YJxKBc"><div class="EAOoq LrGp7b"><div jsname="bgckF" id="fuyiek1nlNk/qJTHM" jscontroller="jBZOGf" jsaction="GzlhMc:XmhAUe;uXbAfb:LgnD0b;gDFVab:gBYM0b;ePoIFc:jtrPDe;" class="DTp27d QIJiHb  Zc1Emd">-- 1. Creación de la Base de Datos<br>CREATE DATABASE IF NOT EXISTS Citas;<br>USE Citas;<br><br>-- 2. Creación de Tablas basadas en el Diagrama Relacional<br><br>CREATE TABLE IF NOT EXISTS Consultorios (<br>&nbsp; &nbsp; ConNumero INT NOT NULL,<br>&nbsp; &nbsp; ConNombre VARCHAR(50) NOT NULL,<br>&nbsp; &nbsp; ConDetalle VARCHAR(100) NULL,<br>&nbsp; &nbsp; PRIMARY KEY (ConNumero)<br>);<br><br>CREATE TABLE IF NOT EXISTS Medicos (<br>&nbsp; &nbsp; MedIdentificacion CHAR(10) NOT NULL,<br>&nbsp; &nbsp; MedNombres VARCHAR(50) NOT NULL,<br>&nbsp; &nbsp; MedApellidos VARCHAR(50) NOT NULL,<br>&nbsp; &nbsp; PRIMARY KEY (MedIdentificacion)<br>);<br><br>CREATE TABLE IF NOT EXISTS Pacientes (<br>&nbsp; &nbsp; PacIdentificacion CHAR(10) NOT NULL,<br>&nbsp; &nbsp; PacNombres VARCHAR(50) NOT NULL,<br>&nbsp; &nbsp; PacApellidos VARCHAR(50) NOT NULL,<br>&nbsp; &nbsp; PacFechaNacimiento DATE NOT NULL,<br>&nbsp; &nbsp; PacSexo ENUM('M', 'F') NOT NULL,<br>&nbsp; &nbsp; PRIMARY KEY (PacIdentificacion)<br>);<br><br>CREATE TABLE IF NOT EXISTS Tratamientos (<br>&nbsp; &nbsp; TraNumero INT NOT NULL AUTO_INCREMENT,<br>&nbsp; &nbsp; TraFechaAsignado DATE NOT NULL,<br>&nbsp; &nbsp; TraDescripcion TEXT NOT NULL,<br>&nbsp; &nbsp; TraFechaInicio DATE NOT NULL,<br>&nbsp; &nbsp; TraFechaFin DATE NOT NULL,<br>&nbsp; &nbsp; TraObservaciones TEXT NOT NULL,<br>&nbsp; &nbsp; TraPaciente CHAR(10) NOT NULL,<br>&nbsp; &nbsp; PRIMARY KEY (TraNumero),<br>&nbsp; &nbsp; FOREIGN KEY (TraPaciente) REFERENCES Pacientes (PacIdentificacion)<br>);<br><br>CREATE TABLE IF NOT EXISTS Citas (<br>&nbsp; &nbsp; CitNumero INT NOT NULL AUTO_INCREMENT,<br>&nbsp; &nbsp; CitFecha DATE NOT NULL,<br>&nbsp; &nbsp; CitHora VARCHAR(10) NOT NULL,<br>&nbsp; &nbsp; CitPaciente CHAR(10) NOT NULL,<br>&nbsp; &nbsp; CitMedico CHAR(10) NOT NULL,<br>&nbsp; &nbsp; CitConsultorio INT NOT NULL,<br>&nbsp; &nbsp; CitEstado ENUM('Asignada', 'Cumplida', 'Solicitada', 'Cancelada') NOT NULL DEFAULT 'Asignada',<br>&nbsp; &nbsp; CitObservaciones TEXT NULL,<br>&nbsp; &nbsp; PRIMARY KEY (CitNumero),<br>&nbsp; &nbsp; FOREIGN KEY (CitPaciente) REFERENCES Pacientes (PacIdentificacion),<br>&nbsp; &nbsp; FOREIGN KEY (CitMedico) REFERENCES Medicos (MedIdentificacion),<br>&nbsp; &nbsp; FOREIGN KEY (CitConsultorio) REFERENCES Consultorios (ConNumero)<br>);<br><br>-- 3. Inserción de Datos según la Guía<br><br>-- Consultorios<br>INSERT INTO Consultorios (ConNumero, ConNombre, ConDetalle) VALUES <br>(1, 'Terapias', 'Asignado para Terapia Respiratoria'),<br>(2, 'Terapias', 'Asignado para Terapia Respiratoria'),<br>(3, 'Terapias', 'Asignado para Terapia Motriz'),<br>(4, 'Medicina', 'Asignado para Medico General'),<br>(5, 'Medicina', 'Asignado para Medico General'),<br>(6, 'Medicina', 'Asignado para Medico Especialista'),<br>(7, 'Psicologia', 'Asignado para Psicologo de adultos'),<br>(8, 'Psicologia', 'Asignado para Psicologo infantil'),<br>(9, 'Odontologia', 'Tratamientos de cirugia odontologica'),<br>(10, 'Nutricionista', 'Nutricion de adultos mayores');<br><br>-- Médicos<br>INSERT INTO Medicos (MedIdentificacion, MedNombres, MedApellidos) VALUES <br>('01', 'Laura', 'Castellanos'),<br>('02', 'Jose', 'Perez'),<br>('03', 'Leonardo', 'Urquijo'),<br>('04', 'Paola', 'Perez'),<br>('05', 'Diana', 'López'),<br>('06', 'Jose', 'Melendez'),<br>('07', 'Diana', 'Quintero'),<br>('08', 'Paola', 'Jimenez'),<br>('09', 'Leonardo', 'López'),<br>('10', 'Viviana', 'López');<br><br>-- Pacientes<br>INSERT INTO Pacientes (PacIdentificacion, PacNombres, PacApellidos, PacFechaNacimiento, PacSexo) VALUES <br>('01', 'Maria Jose', 'Gutierrez Perez', '2025-09-02', 'F'),<br>('02', 'Mariano', 'Perez Lopez', '1987-12-25', 'M'),<br>('03', 'Juliana', 'Silva', '2008-05-12', 'F'),<br>('04', 'Maria Fernanda', 'Jimenez', '1972-05-18', 'F'),<br>('05', 'Lorenzo', 'Hernandez', '1975-10-09', 'M'),<br>('06', 'Maria Pilar', 'Linares', '2010-12-25', 'F'),<br>('07', 'Monica', 'Vergara', '1954-10-08', 'F'),<br>('08', 'Andrea Del Pilar', 'Sanchez', '1942-02-20', 'F'),<br>('09', 'Pedro', 'Salazar', '1985-05-25', 'M');<br><br>-- Tratamientos<br>INSERT INTO Tratamientos (TraNumero, TraFechaAsignado, TraDescripcion, TraFechaInicio, TraFechaFin, TraObservaciones, TraPaciente) VALUES <br>(1, '2026-08-08', 'Tratamiento de terapia respiratoria', '2026-08-06', '2026-08-12', 'Se deben realizar 6 terapias', '02'),<br>(2, '2026-08-12', 'Tratamiento de terapias respiratoria pediatrica', '2026-08-09', '2026-08-15', 'Se deben realizar 5 terapias', '05'),<br>(3, '2026-08-12', 'Cita Medico General', '2026-08-15', '2026-08-20', 'Se realiza cita de medico general', '06'),<br>(4, '2026-08-08', 'Cita Odontologica', '2026-09-04', '2026-09-04', 'Cita Odontologica', '05');<br><br>-- Citas<br>INSERT INTO Citas (CitNumero, CitFecha, CitHora, CitPaciente, CitMedico, CitConsultorio, CitEstado) VALUES <br>(1, '2026-08-29', '9:00', '02', '06', 6, 'Asignada'),<br>(2, '2026-08-29', '10:00', '02', '07', 7, 'Asignada'),<br>(3, '2026-08-29', '11:00', '01', '02', 1, 'Cumplida'),<br>(4, '2026-08-08', '12:00', '05', '03', 4, 'Cumplida'),<br>(5, '2026-08-08', '12:00', '03', '01', 5, 'Solicitada'),<br>(6, '2026-08-29', '11:00', '02', '01', 8, 'Cumplida'),<br>(7, '2026-08-08', '10:00', '02', '01', 8, 'Cumplida');<br><br>-- 4. Verificación de datos<br>SELECT * FROM Consultorios;<br>SELECT * FROM Medicos;<br>SELECT * FROM Pacientes;<br>SELECT * FROM Tratamientos;<br>SELECT * FROM Citas;<span style="display: none;"></span></div><div class="R7SUqc dNzQcf" id="fuyiek1nlNk/Vj9hfc"><div class="xLoQZb FVe8Ud" jsname="QcZEyb" jsdata="E513sd;fuyiek1nlNk,dm/5PvVNKAAAAE;$135"><div class="hWwVef" data-max-visible-avatar-count="1" data-max-names-count="5" data-id-prefix="c46" data-with-tooltip="false" data-with-hover-cards="false" data-show-read-receipts-list="true" data-is-one-on-one-